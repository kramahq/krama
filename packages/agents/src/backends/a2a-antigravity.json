{
  "$schema": "../../../contract/schemas/backend-descriptor.schema.json",
  "id": "a2a-antigravity",
  "label": "Google Antigravity",
  "description": "Google Antigravity (Gemini) through a managed Python bridge.",
  "package": {
    "name": "a2a-antigravity",
    "bin": "a2a-antigravity",
    "install": "npm i -g a2a-antigravity",
    "docs": "https://a2a-wrapper.allsrc.dev",
    "minVersion": "0.2.2"
  },
  "launch": {
    "defaultPort": 3040,
    "readyPath": "/.well-known/agent-card.json",
    "startupTimeoutMs": 180000,
    "extraArgs": []
  },
  "providerKey": "antigravity",
  "mapping": {
    "workspace": "workingDirectory",
    "model": "model",
    "systemPrompt": "systemInstructions"
  },
  "options": [
    {
      "key": "appDataDir",
      "type": "string",
      "description": "SDK app data directory."
    },
    {
      "key": "bridgePath",
      "type": "string",
      "description": "Override path to the private bridge.py."
    },
    {
      "key": "capabilities",
      "type": "object",
      "description": "capabilities"
    },
    {
      "key": "conversationId",
      "type": "string",
      "description": "Existing SDK conversation id to resume."
    },
    {
      "key": "model",
      "type": "string",
      "description": "Text model name."
    },
    {
      "key": "policies",
      "type": "object",
      "description": "policies"
    },
    {
      "key": "provider",
      "type": "object",
      "description": "provider"
    },
    {
      "key": "pythonPath",
      "type": "string",
      "description": "Python executable used for the private bridge."
    },
    {
      "key": "responseSchema",
      "type": "any",
      "description": "JSON schema object or path string for structured output."
    },
    {
      "key": "saveDir",
      "type": "string",
      "description": "Persistent SDK save directory."
    },
    {
      "key": "skillsPaths",
      "type": "string[]",
      "description": "Skill directory paths to pass to Antigravity."
    },
    {
      "key": "systemInstructions",
      "type": "string",
      "description": "Appended system instructions."
    },
    {
      "key": "workingDirectory",
      "type": "string",
      "description": "Convenience primary workspace."
    },
    {
      "key": "workspaces",
      "type": "string[]",
      "description": "Workspace allowlist passed to LocalAgentConfig.workspaces."
    }
  ],
  "env": [
    {
      "name": "GEMINI_API_KEY",
      "description": "Gemini API key (auth mode apiKey).",
      "secret": true,
      "group": "auth"
    },
    {
      "name": "GOOGLE_APPLICATION_CREDENTIALS",
      "description": "Application Default Credentials file (auth mode adc).",
      "group": "auth"
    }
  ],
  "prerequisites": [
    {
      "id": "node",
      "description": "Node.js 20 or newer",
      "kind": "runtime",
      "check": {
        "command": ["node", "--version"],
        "expect": "^v(2\\d|[3-9]\\d)"
      },
      "install": {
        "any": "https://nodejs.org"
      }
    },
    {
      "id": "wrapper",
      "description": "a2a-antigravity is installed",
      "kind": "binary",
      "check": {
        "command": ["a2a-antigravity", "--version"]
      },
      "install": {
        "any": "npm i -g a2a-antigravity"
      }
    },
    {
      "id": "python",
      "description": "Python 3.10 or newer (the wrapper manages its own virtualenv)",
      "kind": "runtime",
      "check": {
        "command": ["python3", "--version"],
        "expect": "Python 3\\.(1\\d|[2-9]\\d)"
      },
      "install": {
        "macos": "brew install python",
        "linux": "apt install python3 python3-venv",
        "windows": "winget install Python.Python.3.12"
      }
    }
  ],
  "capabilities": {
    "canOrchestrate": true,
    "cost": "unknown",
    "sideband": true,
    "resumableSessions": true
  },
  "models": ["gemini-3"]
}
