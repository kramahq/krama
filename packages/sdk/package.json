{
  "name": "@kramahq/sdk",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "default": "./dist/conformance.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "generate": "node scripts/generate.mjs && prettier --write src/generated/operations.ts",
    "generate:check": "node scripts/generate.mjs --check"
  },
  "dependencies": {
    "@kramahq/contract": "workspace:*"
  },
  "devDependencies": {
    "zod": "^4.6.5",
    "prettier": "^3.9.9"
  }
}
