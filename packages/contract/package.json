{
  "name": "@kramahq/contract",
  "version": "0.0.0",
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fixtures/*": "./fixtures/*",
    "./openapi.json": "./openapi.json",
    "./package.json": "./package.json",
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "dist",
    "fixtures",
    "openapi.json",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "openapi": "tsc -b && node dist/openapi-cli.js"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
